generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String
  province  String
  campuses  Campus[]
  createdAt DateTime @default(now())
}

model Campus {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  name         String
  address      String
  lat          Float
  lng          Float
  properties   Property[]
}

model Property {
  id          String   @id @default(cuid())
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  ownerEmail  String?  
  name        String
  description String
  price       Int
  gender      String
  imageUrl    String?
  createdAt   DateTime @default(now())
}